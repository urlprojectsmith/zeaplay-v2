# syntax=docker/dockerfile:1.7

FROM node:22.23.3-alpine3.24 AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@11.3.0 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/api-client/package.json packages/api-client/package.json
COPY packages/auth/package.json packages/auth/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/events/package.json packages/events/package.json
COPY packages/logger/package.json packages/logger/package.json
COPY packages/types/package.json packages/types/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY packages/validation/package.json packages/validation/package.json
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store pnpm install --frozen-lockfile

FROM deps AS builder
ENV NODE_ENV=production
COPY . .
RUN --mount=type=cache,id=prisma-cache,target=/root/.cache/prisma \
    pnpm --filter @zea-play/api... build

FROM builder AS prod-deps
RUN pnpm prune --prod

FROM node:22.23.3-alpine3.24 AS runner
ENV NODE_ENV=production
ENV API_PORT=7111
WORKDIR /app

RUN addgroup -S zeaplay && adduser -S zeaplay -G zeaplay

COPY --from=prod-deps --chown=zeaplay:zeaplay /app/node_modules ./node_modules
COPY --from=prod-deps --chown=zeaplay:zeaplay /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder --chown=zeaplay:zeaplay /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=zeaplay:zeaplay /app/apps/api/prisma ./apps/api/prisma
COPY --from=builder --chown=zeaplay:zeaplay /app/apps/api/prisma.config.ts ./apps/api/prisma.config.ts
COPY --from=builder --chown=zeaplay:zeaplay /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder --chown=zeaplay:zeaplay /app/packages ./packages
COPY --from=builder --chown=zeaplay:zeaplay /app/package.json /app/pnpm-workspace.yaml ./

USER zeaplay
EXPOSE 7111
CMD ["node", "apps/api/dist/src/main.js"]
