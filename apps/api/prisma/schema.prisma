  workspaceId    String?  @map("workspace_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String   @db.VarChar(120)
  entityType     String   @map("entity_type") @db.VarChar(80)
  entityId       String?  @map("entity_id") @db.Uuid
  metadata       Json?
  ipAddress      String?  @map("ip_address") @db.VarChar(80)
  userAgent      String?  @map("user_agent") @db.VarChar(512)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  agency       Agency?       @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  workspace    Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([agencyId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
