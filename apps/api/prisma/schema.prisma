  relatedTaskBLinks           TaskRelatedTask[]          @relation("TaskRelatedTaskB")
  tags                        TaskTag[]
  comments                    TaskComment[]
  attachments                 TaskAttachment[]
  completionPolicy            TaskCompletionPolicy?
  completionSubmissions       TaskCompletionSubmission[] @relation("TaskCompletionSubmissions")
  timeEntries                 TaskTimeEntry[]
  workloadAllocations         TaskWorkloadAllocation[]

  @@unique([id, workspaceId])
  @@unique([recurrenceSeriesId, recurrenceSequence])
  @@index([workspaceId, pendingCompletionSubmissionId])
  @@index([workspaceId, statusDefinitionId, createdAt])
  @@index([workspaceId, statusDefinitionId, kanbanRank, createdAt])
  @@index([workspaceId, recurrenceSeriesId, recurrenceSequence])
  @@index([workspaceId, priority, createdAt])
