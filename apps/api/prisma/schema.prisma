generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AgencyStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum RoleScope {
  LEGACY_ORGANIZATION
  AGENCY
  WORKSPACE
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AssetStatus {
  PENDING
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  FAILED
  DELETED
}

enum ProcessingJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum StatusEntityType {
  TASK
  PROJECT
  TICKET
}

enum StatusCategory {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskCommentVisibility {
  NORMAL
  INTERNAL
}

enum TaskCommentReactionType {
  LIKE
  LOVE
  CELEBRATE
  EYES
  CHECK
}

enum WorkspaceTagStatus {
  ACTIVE
  ARCHIVED
}

enum AttachmentType {
  FILE
  URL
}

enum TaskRecurrenceFrequency {
  DAILY
  WEEKDAYS
  WEEKLY
  MONTHLY
  CUSTOM
}

enum TaskRecurrenceCustomUnit {
  DAY
  WEEK
  MONTH
}

enum TaskRecurrenceStatus {
  ACTIVE
  PAUSED
  ENDED
  ERROR
}

enum TaskRecurrenceEndMode {
  NEVER
  ON_DATE
  AFTER_COUNT
}

enum TaskTemplateStatus {
  ACTIVE
  ARCHIVED
}

enum TaskTimeEntryType {
  TIMER
  MANUAL
}

enum TaskTimeEntryStopReason {
  USER
  SWITCHED_TASK
  TASK_TERMINAL
  TASK_DELETED
  ADMIN
}

enum TaskCompletionProofRequirementMode {
  NONE
  ANY
  SPECIFIC
}

enum TaskCompletionProofType {
  TEXT
  ATTACHMENT
  URL
  CHECKLIST_CONFIRMATION
}

enum TaskCompletionApproverMode {
  ANY_ONE
  ALL_REQUIRED
}

enum TaskCompletionSubmissionStatus {
  PENDING_APPROVAL
  ACCEPTED
  REJECTED
}

enum TaskCompletionDecision {
  APPROVED
  REJECTED
}

model SystemHealth {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  component String   @db.VarChar(120)
  status    String   @db.VarChar(40)
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)
  metadata  Json?

  @@index([component], map: "idx_system_health_component")
  @@map("system_health")
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String     @unique @db.VarChar(320)
  name         String?    @db.VarChar(160)
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships                   Membership[]
  agencyMemberships             AgencyMembership[]
  workspaceMemberships          WorkspaceMembership[]
  refreshTokens                 RefreshToken[]
  projects                      Project[]              @relation("ProjectCreator")
  tasksCreated                  Task[]                 @relation("TaskCreator")
  tasksUpdated                  Task[]                 @relation("TaskUpdater")
  taskRecurrenceSeriesCreated   TaskRecurrenceSeries[] @relation("TaskRecurrenceSeriesCreator")
  taskRecurrenceSeriesUpdated   TaskRecurrenceSeries[] @relation("TaskRecurrenceSeriesUpdater")
  taskTemplatesCreated          TaskTemplate[]         @relation("TaskTemplateCreator")
  taskTemplatesUpdated          TaskTemplate[]         @relation("TaskTemplateUpdater")
  taskCompletionPoliciesCreated TaskCompletionPolicy[] @relation("TaskCompletionPolicyCreator")
  taskCompletionPoliciesUpdated TaskCompletionPolicy[] @relation("TaskCompletionPolicyUpdater")
  taskTimeEntries               TaskTimeEntry[]
  taskDependenciesCreated       TaskDependency[]       @relation("TaskDependencyCreator")
  taskRelatedLinksCreated       TaskRelatedTask[]      @relation("TaskRelatedTaskCreator")
  workspaceTagsCreated          WorkspaceTag[]         @relation("WorkspaceTagCreator")
  taskTagsCreated               TaskTag[]              @relation("TaskTagCreator")
  taskCommentsAuthored          TaskComment[]          @relation("TaskCommentAuthorUser")
  attachmentsCreated            Attachment[]
  taskAttachmentsAttached       TaskAttachment[]
  projectAttachmentsAttached    ProjectAttachment[]
  assets                        Asset[]
  auditLogs                     AuditLog[]
  agenciesCreated               Agency[]               @relation("AgencyCreator")
  workspacesCreated             Workspace[]            @relation("WorkspaceCreator")

  @@map("users")
}

model Organization {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String             @db.VarChar(160)
  slug              String             @unique @db.VarChar(120)
  status            OrganizationStatus @default(ACTIVE)
  storageUsedBytes  BigInt             @default(0) @map("storage_used_bytes")
  storageLimitBytes BigInt             @default(1073741824) @map("storage_limit_bytes")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships Membership[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

model Agency {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String       @db.VarChar(160)
  slug        String       @unique @db.VarChar(120)
  status      AgencyStatus @default(ACTIVE)
  createdById String       @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy           User                 @relation("AgencyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  memberships         AgencyMembership[]
  workspaces          Workspace[]
  featureEntitlements FeatureEntitlement[]
  auditLogs           AuditLog[]

  @@index([status])
  @@index([createdById])
  @@map("agencies")
}

model Workspace {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId          String          @map("agency_id") @db.Uuid
  name              String          @db.VarChar(160)
  slug              String          @db.VarChar(120)
  timezone          String          @default("UTC") @db.VarChar(80)
  status            WorkspaceStatus @default(ACTIVE)
  storageUsedBytes  BigInt          @default(0) @map("storage_used_bytes")
  storageLimitBytes BigInt          @default(1073741824) @map("storage_limit_bytes")
  createdById       String          @map("created_by_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  agency                            Agency                             @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  createdBy                         User                               @relation("WorkspaceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  memberships                       WorkspaceMembership[]
  departments                       Department[]
  statusDefinitions                 StatusDefinition[]
  projects                          Project[]
  tasks                             Task[]
  taskRecurrenceSeries              TaskRecurrenceSeries[]
  taskTemplates                     TaskTemplate[]
  taskCompletionPolicies            TaskCompletionPolicy[]
  taskCompletionPolicyApprovers     TaskCompletionPolicyApprover[]
  taskCompletionSubmissions         TaskCompletionSubmission[]
  taskCompletionProofItems          TaskCompletionProofItem[]
  taskCompletionProofAttachments    TaskCompletionProofAttachment[]
  taskCompletionSubmissionApprovers TaskCompletionSubmissionApprover[]
  taskCompletionApprovalDecisions   TaskCompletionApprovalDecision[]
  taskTimeEntries                   TaskTimeEntry[]
  taskWorkloadAllocations           TaskWorkloadAllocation[]
  workspaceMemberCapacities         WorkspaceMemberCapacity[]
  taskRecurrenceCompletionApprovers TaskRecurrenceCompletionApprover[]
  taskRecurrenceAssignees           TaskRecurrenceAssignee[]
  taskRecurrenceFollowers           TaskRecurrenceFollower[]
  taskRecurrenceProjects            TaskRecurrenceProject[]
  taskRecurrenceTags                TaskRecurrenceTag[]
  taskTemplateAssignees             TaskTemplateAssignee[]
  taskTemplateFollowers             TaskTemplateFollower[]
  taskTemplateProjects              TaskTemplateProject[]
  taskTemplateTags                  TaskTemplateTag[]
  taskAssignees                     TaskAssignee[]
  taskFollowers                     TaskFollower[]
  taskProjects                      TaskProject[]
  taskDependencies                  TaskDependency[]
  taskRelatedTasks                  TaskRelatedTask[]
  workspaceTags                     WorkspaceTag[]
  taskTags                          TaskTag[]
  taskComments                      TaskComment[]
  taskCommentMentions               TaskCommentMention[]
  taskCommentReactions              TaskCommentReaction[]
  taskKanbanColumnSettings          TaskKanbanColumnSetting[]
  attachments                       Attachment[]
  taskAttachments                   TaskAttachment[]
  projectAttachments                ProjectAttachment[]
  assets                            Asset[]
  processingJobs                    ProcessingJob[]
  featureEntitlements               FeatureEntitlement[]
  auditLogs                         AuditLog[]

  @@unique([agencyId, slug])
  @@unique([id, agencyId])
  @@index([agencyId])
  @@index([agencyId, status])
  @@map("workspaces")
}

model Department {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String           @map("workspace_id") @db.Uuid
  name                String           @db.VarChar(160)
  description         String?          @db.VarChar(500)
  status              DepartmentStatus @default(ACTIVE)
  managerMembershipId String?          @map("manager_membership_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace            Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  managerMembership    WorkspaceMembership?   @relation("DepartmentManager", fields: [managerMembershipId], references: [id], onDelete: SetNull)
  members              WorkspaceMembership[]  @relation("DepartmentMembers")
  projects             Project[]
  tasks                Task[]
  taskRecurrenceSeries TaskRecurrenceSeries[]
  taskTemplates        TaskTemplate[]

  @@unique([workspaceId, name])
  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, managerMembershipId])
  @@map("departments")
}

model Membership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

model AgencyMembership {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  agencyId  String           @map("agency_id") @db.Uuid
  roleId    String           @map("role_id") @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, agencyId])
  @@index([agencyId])
  @@index([userId])
  @@map("agency_memberships")
}

model WorkspaceMembership {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  workspaceId  String           @map("workspace_id") @db.Uuid
  roleId       String           @map("role_id") @db.Uuid
  departmentId String?          @map("department_id") @db.Uuid
  status       MembershipStatus @default(ACTIVE)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                           User                               @relation(fields: [userId], references: [id], onDelete: Restrict)
  workspace                      Workspace                          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  role                           Role                               @relation(fields: [roleId], references: [id], onDelete: Restrict)
  department                     Department?                        @relation("DepartmentMembers", fields: [departmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  managedDepartments             Department[]                       @relation("DepartmentManager")
  assignedTasks                  TaskAssignee[]
  followedTasks                  TaskFollower[]
  taskComments                   TaskComment[]                      @relation("TaskCommentAuthor")
  commentMentions                TaskCommentMention[]
  commentReactions               TaskCommentReaction[]
  recurrenceAssignees            TaskRecurrenceAssignee[]
  recurrenceFollowers            TaskRecurrenceFollower[]
  templateAssignees              TaskTemplateAssignee[]
  templateFollowers              TaskTemplateFollower[]
  completionPolicyApprovers      TaskCompletionPolicyApprover[]
  completionSubmissionsSubmitted TaskCompletionSubmission[]         @relation("TaskCompletionSubmittedBy")
  completionSubmissionApprovals  TaskCompletionSubmissionApprover[] @relation("TaskCompletionSubmissionApproverMembership")
  completionApprovalDecisions    TaskCompletionApprovalDecision[]   @relation("TaskCompletionDecisionApprover")
  recurrenceCompletionApprovers  TaskRecurrenceCompletionApprover[]
  taskTimeEntries                TaskTimeEntry[]                    @relation("TaskTimeEntryMembership")
  taskTimeEntriesCreated         TaskTimeEntry[]                    @relation("TaskTimeEntryCreator")
  taskTimeEntriesUpdated         TaskTimeEntry[]                    @relation("TaskTimeEntryUpdater")
  taskTimeEntriesDeleted         TaskTimeEntry[]                    @relation("TaskTimeEntryDeleter")
  taskWorkloadAllocations        TaskWorkloadAllocation[]
  workspaceMemberCapacity        WorkspaceMemberCapacity?

  @@unique([userId, workspaceId])
  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, roleId])
  @@index([workspaceId, departmentId])
  @@index([userId])
  @@map("workspace_memberships")
}

model Role {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key            String    @unique @db.VarChar(120)
  name           String    @db.VarChar(80)
  nameNormalized String?   @map("name_normalized") @db.VarChar(80)
  scope          RoleScope @default(WORKSPACE)
  isSystem       Boolean   @default(true) @map("is_system")
  isActive       Boolean   @default(true) @map("is_active")
  workspaceId    String?   @map("workspace_id") @db.Uuid
  description    String?   @db.VarChar(240)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships          Membership[]
  agencyMemberships    AgencyMembership[]
  workspaceMemberships WorkspaceMembership[]
  rolePermissions      RolePermission[]

  @@unique([workspaceId, nameNormalized])
  @@index([scope])
  @@index([workspaceId])
  @@index([workspaceId, isActive])
  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique @db.VarChar(120)
  description String?  @db.VarChar(240)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model StatusDefinition {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String           @map("workspace_id") @db.Uuid
  entityType     StatusEntityType @map("entity_type")
  name           String           @db.VarChar(80)
  nameNormalized String           @map("name_normalized") @db.VarChar(80)
  description    String?          @db.VarChar(240)
  color          String           @db.VarChar(7)
  position       Int
  category       StatusCategory
  isDefault      Boolean          @default(false) @map("is_default")
  isTerminal     Boolean          @default(false) @map("is_terminal")
  isActive       Boolean          @default(true) @map("is_active")
  isSystem       Boolean          @default(false) @map("is_system")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace                      Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  projects                       Project[]
  tasks                          Task[]
  taskKanbanColumnSettings       TaskKanbanColumnSetting[]
  taskRecurrenceSeries           TaskRecurrenceSeries[]
  taskTemplates                  TaskTemplate[]
  requestedCompletionSubmissions TaskCompletionSubmission[] @relation("TaskCompletionRequestedStatus")
  previousCompletionSubmissions  TaskCompletionSubmission[] @relation("TaskCompletionPreviousStatus")

  @@unique([workspaceId, entityType, nameNormalized])
  @@unique([id, workspaceId])
  @@index([workspaceId, entityType, isActive, position])
  @@map("status_definitions")
}

model RefreshToken {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  csrfTokenHash String    @map("csrf_token_hash")
  familyId      String    @map("family_id") @db.Uuid
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy    String?   @map("replaced_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Project {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String        @map("workspace_id") @db.Uuid
  name               String        @db.VarChar(160)
  description        String?       @db.VarChar(1000)
  status             ProjectStatus @default(DRAFT)
  statusDefinitionId String?       @map("status_definition_id") @db.Uuid
  priority           TaskPriority  @default(MEDIUM)
  plannedStartAt     DateTime?     @map("planned_start_at") @db.Timestamptz(6)
  dueAt              DateTime?     @map("due_at") @db.Timestamptz(6)
  departmentId       String?       @map("department_id") @db.Uuid
  createdById        String        @map("created_by_id") @db.Uuid
  archivedAt         DateTime?     @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace           Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  statusDefinition    StatusDefinition?       @relation(fields: [statusDefinitionId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  department          Department?             @relation(fields: [departmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  createdBy           User                    @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assets              Asset[]
  attachments         ProjectAttachment[]
  processingJobs      ProcessingJob[]
  taskLinks           TaskProject[]
  taskRecurrenceLinks TaskRecurrenceProject[]
  taskTemplateLinks   TaskTemplateProject[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, statusDefinitionId])
  @@index([workspaceId, priority])
  @@index([workspaceId, dueAt])
  @@index([workspaceId, plannedStartAt])
  @@index([workspaceId, departmentId])
  @@index([workspaceId, createdAt])
  @@map("projects")
}

model Task {
  id                            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId                   String       @map("workspace_id") @db.Uuid
  title                         String       @db.VarChar(160)
  description                   String?      @db.VarChar(4000)
  priority                      TaskPriority @default(MEDIUM)
  statusDefinitionId            String       @map("status_definition_id") @db.Uuid
  parentTaskId                  String?      @map("parent_task_id") @db.Uuid
  departmentId                  String?      @map("department_id") @db.Uuid
  plannedStartAt                DateTime?    @map("planned_start_at") @db.Timestamptz(6)
  dueAt                         DateTime?    @map("due_at") @db.Timestamptz(6)
  estimatedMinutes              Int?         @map("estimated_minutes")
  kanbanRank                    Decimal?     @map("kanban_rank") @db.Decimal(30, 12)
  recurrenceSeriesId            String?      @map("recurrence_series_id") @db.Uuid
  recurrenceScheduledFor        DateTime?    @map("recurrence_scheduled_for") @db.Timestamptz(6)
  recurrenceSequence            Int?         @map("recurrence_sequence")
  recurrenceIsException         Boolean      @default(false) @map("recurrence_is_exception")
  pendingCompletionSubmissionId String?      @map("pending_completion_submission_id") @db.Uuid
  createdById                   String       @map("created_by_id") @db.Uuid
  updatedById                   String?      @map("updated_by_id") @db.Uuid
  archivedAt                    DateTime?    @map("archived_at") @db.Timestamptz(6)
  deletedAt                     DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdAt                     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace                   Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  statusDefinition            StatusDefinition           @relation(fields: [statusDefinitionId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  parentTask                  Task?                      @relation("TaskHierarchy", fields: [parentTaskId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  subtasks                    Task[]                     @relation("TaskHierarchy")
  department                  Department?                @relation(fields: [departmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  recurrenceSeries            TaskRecurrenceSeries?      @relation(fields: [recurrenceSeriesId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  pendingCompletionSubmission TaskCompletionSubmission?  @relation("TaskPendingCompletionSubmission", fields: [pendingCompletionSubmissionId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  createdBy                   User                       @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy                   User?                      @relation("TaskUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  assignees                   TaskAssignee[]
  followers                   TaskFollower[]
  projects                    TaskProject[]
  blockingDependencies        TaskDependency[]           @relation("TaskDependencyBlocker")
  blockedByDependencies       TaskDependency[]           @relation("TaskDependencyBlocked")
  relatedTaskALinks           TaskRelatedTask[]          @relation("TaskRelatedTaskA")
  relatedTaskBLinks           TaskRelatedTask[]          @relation("TaskRelatedTaskB")
  tags                        TaskTag[]
  comments                    TaskComment[]
  attachments                 TaskAttachment[]
  completionPolicy            TaskCompletionPolicy?
  completionSubmissions       TaskCompletionSubmission[] @relation("TaskCompletionSubmissions")
  timeEntries                 TaskTimeEntry[]
  workloadAllocations         TaskWorkloadAllocation[]

  @@unique([id, workspaceId])
  @@unique([recurrenceSeriesId, recurrenceSequence])
  @@index([workspaceId, pendingCompletionSubmissionId])
  @@index([workspaceId, statusDefinitionId, createdAt])
  @@index([workspaceId, statusDefinitionId, kanbanRank, createdAt])
  @@index([workspaceId, recurrenceSeriesId, recurrenceSequence])
  @@index([workspaceId, priority, createdAt])
  @@index([workspaceId, plannedStartAt, dueAt])
  @@index([workspaceId, dueAt])
  @@index([workspaceId, estimatedMinutes])
  @@index([workspaceId, parentTaskId, createdAt])
  @@index([workspaceId, departmentId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, createdById])
  @@map("tasks")
}

model TaskTimeEntry {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId           String                   @map("workspace_id") @db.Uuid
  taskId                String                   @map("task_id") @db.Uuid
  userId                String                   @map("user_id") @db.Uuid
