generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AgencyStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum RoleScope {
  LEGACY_ORGANIZATION
  AGENCY
  WORKSPACE
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProjectVisibility {
  WORKSPACE
  RESTRICTED
}

enum AssetStatus {
  PENDING
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  FAILED
  DELETED
}

enum ProcessingJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum StatusEntityType {
  TASK
  PROJECT
  TICKET
}

enum StatusCategory {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskCommentVisibility {
  NORMAL
  INTERNAL
}

enum TaskCommentReactionType {
  LIKE
  LOVE
  CELEBRATE
  EYES
  CHECK
}

enum WorkspaceTagStatus {
  ACTIVE
  ARCHIVED
}

enum AttachmentType {
  FILE
  URL
}

enum TaskRecurrenceFrequency {
  DAILY
  WEEKDAYS
  WEEKLY
  MONTHLY
  CUSTOM
}

enum TaskRecurrenceCustomUnit {
  DAY
  WEEK
  MONTH
}

enum TaskRecurrenceStatus {
  ACTIVE
  PAUSED
  ENDED
  ERROR
}

enum TaskRecurrenceEndMode {
  NEVER
  ON_DATE
  AFTER_COUNT
}

enum TaskTemplateStatus {
  ACTIVE
  ARCHIVED
}

enum TaskTimeEntryType {
  TIMER
  MANUAL
}

enum TaskTimeEntryStopReason {
  USER
  SWITCHED_TASK
  TASK_TERMINAL
  TASK_DELETED
  ADMIN
}

enum TaskCompletionProofRequirementMode {
  NONE
  ANY
  SPECIFIC
}

enum TaskCompletionProofType {
  TEXT
  ATTACHMENT
  URL
  CHECKLIST_CONFIRMATION
}

enum TaskCompletionApproverMode {
  ANY_ONE
  ALL_REQUIRED
}

enum TaskCompletionSubmissionStatus {
  PENDING_APPROVAL
  ACCEPTED
  REJECTED
}

enum TaskCompletionDecision {
  APPROVED
  REJECTED
}

enum TicketRequesterType {
  INTERNAL
  EXTERNAL
}

enum TicketConversationEntryType {
  PUBLIC_REPLY
  INTERNAL_NOTE
}

enum TicketSlaBusinessMode {
  ALWAYS
  BUSINESS_HOURS
}

enum TicketSavedViewScope {
  PERSONAL
  WORKSPACE
}

enum TicketEscalationLevel {
  NONE
  LEVEL_1
  LEVEL_2
  LEVEL_3
}

enum GamificationXpEntryType {
  EARN
  DEDUCT
  REVERSAL
  ADJUSTMENT
}

enum GamificationXpSourceType {
  TASK
  PROJECT
  TICKET
  STREAK
  ACHIEVEMENT
  MANUAL
  SYSTEM
}

enum GamificationAchievementCriterionType {
  XP_TOTAL_AT_LEAST
  TASK_COMPLETED_COUNT
  PROJECT_COMPLETED_COUNT
  TICKET_RESOLVED_COUNT
}

enum GamificationStreakQualificationType {
  TASK_COMPLETED
  TICKET_RESOLVED
}

enum GamificationRewardPointEntryType {
  EARN
  SPEND
  REFUND
  ADJUSTMENT
  REVERSAL
}

enum GamificationRewardPointSourceType {
  ACHIEVEMENT
  STREAK
  REWARD_REDEMPTION
  MANUAL
  SYSTEM
}

enum GamificationRewardInventoryMode {
  UNLIMITED
  LIMITED
}

enum GamificationRewardRedemptionStatus {
  PENDING
  FULFILLED
  CANCELLED
}

enum GamificationLeaderboardPrivacyMode {
  SHOW_NAME
  SHOW_DISPLAY_NAME
  ANONYMOUS
  OPT_OUT
}

enum SecurityStepUpPurpose {
  GAMIFICATION_RESET
}

enum GamificationAdminEconomy {
  XP
  REWARD_POINTS
}

enum ProjectXpCategory {
  HIGH
  MEDIUM
  LONG_TERM
}

enum GamificationPointScopeType {
  WORKSPACE
  DEPARTMENT
}

enum GamificationPointWorkType {
  TASK
  PROJECT
  TICKET
}

enum GamificationPointCategory {
  LOW
  MEDIUM
  HIGH
  URGENT
  LONG_TERM
}

enum GamificationWorkXpEventType {
  CREATION_AWARD
  CREATION_REVERSAL
  COMPLETION_AWARD
  COMPLETION_REVERSAL
}

enum GamificationWorkXpEventOutcome {
  APPLIED
  SKIPPED
}

enum GamificationWorkXpSkipReason {
  NOT_CONFIGURED
  RULE_DISABLED
  MISSING_CATEGORY
  INACTIVE_RECIPIENT
  NO_ELIGIBLE_CREATOR
  AMBIGUOUS_ROLE
  NO_PRIOR_AWARD
  ALREADY_REVERSED
  ALREADY_NEUTRALIZED_BY_RESET
  REVERSAL_CONFLICT
}

model SystemHealth {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  component String   @db.VarChar(120)
  status    String   @db.VarChar(40)
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)
  metadata  Json?

  @@index([component], map: "idx_system_health_component")
  @@map("system_health")
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String     @unique @db.VarChar(320)
  name         String?    @db.VarChar(160)
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships                   Membership[]
  agencyMemberships             AgencyMembership[]
  workspaceMemberships          WorkspaceMembership[]
  refreshTokens                 RefreshToken[]
  securityStepUpGrants          SecurityStepUpGrant[]
  securityOtpChallenges         SecurityOtpChallenge[]
  projects                      Project[]                 @relation("ProjectCreator")
  tasksCreated                  Task[]                    @relation("TaskCreator")
  tasksUpdated                  Task[]                    @relation("TaskUpdater")
  taskRecurrenceSeriesCreated   TaskRecurrenceSeries[]    @relation("TaskRecurrenceSeriesCreator")
  taskRecurrenceSeriesUpdated   TaskRecurrenceSeries[]    @relation("TaskRecurrenceSeriesUpdater")
  taskTemplatesCreated          TaskTemplate[]            @relation("TaskTemplateCreator")
  taskTemplatesUpdated          TaskTemplate[]            @relation("TaskTemplateUpdater")
  taskCompletionPoliciesCreated TaskCompletionPolicy[]    @relation("TaskCompletionPolicyCreator")
  taskCompletionPoliciesUpdated TaskCompletionPolicy[]    @relation("TaskCompletionPolicyUpdater")
  taskTimeEntries               TaskTimeEntry[]
  taskDependenciesCreated       TaskDependency[]          @relation("TaskDependencyCreator")
  taskRelatedLinksCreated       TaskRelatedTask[]         @relation("TaskRelatedTaskCreator")
  workspaceTagsCreated          WorkspaceTag[]            @relation("WorkspaceTagCreator")
  taskTagsCreated               TaskTag[]                 @relation("TaskTagCreator")
  projectTagsCreated            ProjectTag[]              @relation("ProjectTagCreator")
  taskCommentsAuthored          TaskComment[]             @relation("TaskCommentAuthorUser")
  ticketConversationAuthored    TicketConversationEntry[] @relation("TicketConversationEntryAuthorUser")
  attachmentsCreated            Attachment[]
  taskAttachmentsAttached       TaskAttachment[]
  projectAttachmentsAttached    ProjectAttachment[]
  ticketAttachmentsAttached     TicketAttachment[]
  assets                        Asset[]
  auditLogs                     AuditLog[]
  agenciesCreated               Agency[]                  @relation("AgencyCreator")
  workspacesCreated             Workspace[]               @relation("WorkspaceCreator")

  @@map("users")
}

model Organization {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String             @db.VarChar(160)
  slug              String             @unique @db.VarChar(120)
  status            OrganizationStatus @default(ACTIVE)
  storageUsedBytes  BigInt             @default(0) @map("storage_used_bytes")
  storageLimitBytes BigInt             @default(1073741824) @map("storage_limit_bytes")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships Membership[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

model Agency {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String       @db.VarChar(160)
  slug        String       @unique @db.VarChar(120)
  status      AgencyStatus @default(ACTIVE)
  createdById String       @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy           User                 @relation("AgencyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  memberships         AgencyMembership[]
  workspaces          Workspace[]
  featureEntitlements FeatureEntitlement[]
  auditLogs           AuditLog[]

  @@index([status])
  @@index([createdById])
  @@map("agencies")
}

model Workspace {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId          String          @map("agency_id") @db.Uuid
  name              String          @db.VarChar(160)
  slug              String          @db.VarChar(120)
  timezone          String          @default("UTC") @db.VarChar(80)
  status            WorkspaceStatus @default(ACTIVE)
  storageUsedBytes  BigInt          @default(0) @map("storage_used_bytes")
  storageLimitBytes BigInt          @default(1073741824) @map("storage_limit_bytes")
  createdById       String          @map("created_by_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  agency                             Agency                              @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  createdBy                          User                                @relation("WorkspaceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  memberships                        WorkspaceMembership[]
  departments                        Department[]
  statusDefinitions                  StatusDefinition[]
  projects                           Project[]
  projectMembers                     ProjectMember[]
  projectTags                        ProjectTag[]
  tickets                            Ticket[]
  ticketRequesters                   TicketRequester[]
  ticketConversationEntries          TicketConversationEntry[]
  ticketSlaPolicies                  TicketSlaPolicy[]
  ticketSlaRules                     TicketSlaRule[]
  ticketSlaPauseStatuses             TicketSlaPauseStatus[]
  ticketSlaStates                    TicketSlaState[]
  ticketSavedViews                   TicketSavedView[]
  ticketAttachments                  TicketAttachment[]
  ticketConversationAttachments      TicketConversationAttachment[]
  ticketCounter                      WorkspaceTicketCounter?
  gamificationXpEntries              GamificationXpEntry[]               @relation("GamificationXpEntryWorkspace")
  gamificationLevels                 GamificationLevel[]                 @relation("GamificationLevelWorkspace")
  gamificationBadgeDefinitions       GamificationBadgeDefinition[]       @relation("GamificationBadgeDefinitionWorkspace")
  gamificationAchievementDefinitions GamificationAchievementDefinition[] @relation("GamificationAchievementDefinitionWorkspace")
  gamificationAchievementAwards      GamificationAchievementAward[]      @relation("GamificationAchievementAwardWorkspace")
  gamificationBadgeAwards            GamificationBadgeAward[]            @relation("GamificationBadgeAwardWorkspace")
  gamificationStreakConfig           GamificationStreakConfig?           @relation("GamificationStreakConfigWorkspace")
  gamificationStreakDays             GamificationStreakDay[]             @relation("GamificationStreakDayWorkspace")
  gamificationRewardPointEntries     GamificationRewardPointEntry[]      @relation("GamificationRewardPointEntryWorkspace")
  gamificationRewardDefinitions      GamificationRewardDefinition[]      @relation("GamificationRewardDefinitionWorkspace")
  gamificationRewardRedemptions      GamificationRewardRedemption[]      @relation("GamificationRewardRedemptionWorkspace")
  gamificationLeaderboardConfig      GamificationLeaderboardConfig?      @relation("GamificationLeaderboardConfigWorkspace")
  gamificationLeaderboardPreferences GamificationLeaderboardPreference[] @relation("GamificationLeaderboardPreferenceWorkspace")
  gamificationPointRules             GamificationPointRule[]             @relation("GamificationPointRuleWorkspace")
  gamificationCreationPointRules     GamificationCreationPointRule[]     @relation("GamificationCreationPointRuleWorkspace")
  gamificationWorkXpEvents           GamificationWorkXpEvent[]           @relation("GamificationWorkXpEventWorkspace")
  tasks                              Task[]
  taskRecurrenceSeries               TaskRecurrenceSeries[]
  taskTemplates                      TaskTemplate[]
  taskCompletionPolicies             TaskCompletionPolicy[]
  taskCompletionPolicyApprovers      TaskCompletionPolicyApprover[]
  taskCompletionSubmissions          TaskCompletionSubmission[]
  taskCompletionProofItems           TaskCompletionProofItem[]
  taskCompletionProofAttachments     TaskCompletionProofAttachment[]
  taskCompletionSubmissionApprovers  TaskCompletionSubmissionApprover[]
  taskCompletionApprovalDecisions    TaskCompletionApprovalDecision[]
  taskTimeEntries                    TaskTimeEntry[]
  taskWorkloadAllocations            TaskWorkloadAllocation[]
  workspaceMemberCapacities          WorkspaceMemberCapacity[]
  taskRecurrenceCompletionApprovers  TaskRecurrenceCompletionApprover[]
  taskRecurrenceAssignees            TaskRecurrenceAssignee[]
  taskRecurrenceFollowers            TaskRecurrenceFollower[]
  taskRecurrenceProjects             TaskRecurrenceProject[]
  taskRecurrenceTags                 TaskRecurrenceTag[]
  taskTemplateAssignees              TaskTemplateAssignee[]
  taskTemplateFollowers              TaskTemplateFollower[]
  taskTemplateProjects               TaskTemplateProject[]
  taskTemplateTags                   TaskTemplateTag[]
  taskAssignees                      TaskAssignee[]
  taskFollowers                      TaskFollower[]
  taskProjects                       TaskProject[]
  taskDependencies                   TaskDependency[]
  taskRelatedTasks                   TaskRelatedTask[]
  workspaceTags                      WorkspaceTag[]
  taskTags                           TaskTag[]
  taskComments                       TaskComment[]
  taskCommentMentions                TaskCommentMention[]
  taskCommentReactions               TaskCommentReaction[]
  taskKanbanColumnSettings           TaskKanbanColumnSetting[]
  attachments                        Attachment[]
  taskAttachments                    TaskAttachment[]
  projectAttachments                 ProjectAttachment[]
  assets                             Asset[]
  processingJobs                     ProcessingJob[]
  featureEntitlements                FeatureEntitlement[]
  auditLogs                          AuditLog[]
  securityStepUpGrants               SecurityStepUpGrant[]               @relation("SecurityStepUpGrantWorkspace")
  securityOtpChallenges              SecurityOtpChallenge[]              @relation("SecurityOtpChallengeWorkspace")

  @@unique([agencyId, slug])
  @@unique([id, agencyId])
  @@index([agencyId])
  @@index([agencyId, status])
  @@map("workspaces")
}

model Department {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String           @map("workspace_id") @db.Uuid
  name                String           @db.VarChar(160)
  description         String?          @db.VarChar(500)
  status              DepartmentStatus @default(ACTIVE)
  managerMembershipId String?          @map("manager_membership_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace            Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  managerMembership    WorkspaceMembership?   @relation("DepartmentManager", fields: [managerMembershipId], references: [id], onDelete: SetNull)
  members              WorkspaceMembership[]  @relation("DepartmentMembers")
  projects             Project[]
  tickets              Ticket[]
  tasks                Task[]
  taskRecurrenceSeries TaskRecurrenceSeries[]
  taskTemplates        TaskTemplate[]
  gamificationPointRules         GamificationPointRule[]         @relation("GamificationPointRuleDepartment")
  gamificationCreationPointRules GamificationCreationPointRule[] @relation("GamificationCreationPointRuleDepartment")

  @@unique([workspaceId, name])
  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, managerMembershipId])
  @@map("departments")
}

model Membership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

model AgencyMembership {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  agencyId  String           @map("agency_id") @db.Uuid
  roleId    String           @map("role_id") @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, agencyId])
  @@index([agencyId])
  @@index([userId])
  @@map("agency_memberships")
}

model WorkspaceMembership {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  workspaceId  String           @map("workspace_id") @db.Uuid
  roleId       String           @map("role_id") @db.Uuid
  departmentId String?          @map("department_id") @db.Uuid
  status       MembershipStatus @default(ACTIVE)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                              User                               @relation(fields: [userId], references: [id], onDelete: Restrict)
  workspace                         Workspace                          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  role                              Role                               @relation(fields: [roleId], references: [id], onDelete: Restrict)
  department                        Department?                        @relation("DepartmentMembers", fields: [departmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  managedDepartments                Department[]                       @relation("DepartmentManager")
  assignedTasks                     TaskAssignee[]
  followedTasks                     TaskFollower[]
  taskComments                      TaskComment[]                      @relation("TaskCommentAuthor")
  ticketConversationEntries         TicketConversationEntry[]          @relation("TicketConversationEntryAuthor")
  commentMentions                   TaskCommentMention[]
  commentReactions                  TaskCommentReaction[]
  recurrenceAssignees               TaskRecurrenceAssignee[]
  recurrenceFollowers               TaskRecurrenceFollower[]
  templateAssignees                 TaskTemplateAssignee[]
  templateFollowers                 TaskTemplateFollower[]
  completionPolicyApprovers         TaskCompletionPolicyApprover[]
  completionSubmissionsSubmitted    TaskCompletionSubmission[]         @relation("TaskCompletionSubmittedBy")
  completionSubmissionApprovals     TaskCompletionSubmissionApprover[] @relation("TaskCompletionSubmissionApproverMembership")
  completionApprovalDecisions       TaskCompletionApprovalDecision[]   @relation("TaskCompletionDecisionApprover")
  recurrenceCompletionApprovers     TaskRecurrenceCompletionApprover[]
  taskTimeEntries                   TaskTimeEntry[]                    @relation("TaskTimeEntryMembership")
  taskTimeEntriesCreated            TaskTimeEntry[]                    @relation("TaskTimeEntryCreator")
  taskTimeEntriesUpdated            TaskTimeEntry[]                    @relation("TaskTimeEntryUpdater")
  taskTimeEntriesDeleted            TaskTimeEntry[]                    @relation("TaskTimeEntryDeleter")
  taskWorkloadAllocations           TaskWorkloadAllocation[]
  workspaceMemberCapacity           WorkspaceMemberCapacity?
  ownedProjects                     Project[]                          @relation("ProjectOwner")
  projectMemberships                ProjectMember[]                    @relation("ProjectMemberMembership")
  projectMembersAdded               ProjectMember[]                    @relation("ProjectMemberAddedBy")
  projectProgressUpdates            Project[]                          @relation("ProjectProgressUpdatedBy")
  ticketsCreated                    Ticket[]                           @relation("TicketCreatorMembership")
  ticketsDeleted                    Ticket[]                           @relation("TicketDeletedByMembership")
  ticketRequesterMemberships        TicketRequester[]                  @relation("TicketRequesterMembership")
  ticketsAssigned                   Ticket[]                           @relation("TicketAssignedMembership")
  ticketSavedViewsOwned             TicketSavedView[]                  @relation("TicketSavedViewOwner")
  ticketSavedViewsCreated           TicketSavedView[]                  @relation("TicketSavedViewCreator")
  ticketSavedViewsUpdated           TicketSavedView[]                  @relation("TicketSavedViewUpdater")
  ticketEscalationsChanged          Ticket[]                           @relation("TicketEscalationChangedBy")
  gamificationXpEntries             GamificationXpEntry[]              @relation("GamificationXpEntryTarget")
  gamificationXpActorEntries        GamificationXpEntry[]              @relation("GamificationXpEntryActor")
  gamificationAchievementAwards     GamificationAchievementAward[]     @relation("GamificationAchievementAwardTarget")
  gamificationBadgeAwards           GamificationBadgeAward[]           @relation("GamificationBadgeAwardTarget")
  gamificationStreakDays            GamificationStreakDay[]            @relation("GamificationStreakDayTarget")
  gamificationRewardPointEntries    GamificationRewardPointEntry[]     @relation("GamificationRewardPointEntryTarget")
  gamificationRewardPointActors     GamificationRewardPointEntry[]     @relation("GamificationRewardPointEntryActor")
  gamificationRewardRedemptions     GamificationRewardRedemption[]     @relation("GamificationRewardRedemptionTarget")
  rewardRedemptionsFulfilled        GamificationRewardRedemption[]     @relation("GamificationRewardRedemptionFulfilledBy")
  rewardRedemptionsCancelled        GamificationRewardRedemption[]     @relation("GamificationRewardRedemptionCancelledBy")
  gamificationWorkXpEvents          GamificationWorkXpEvent[]          @relation("GamificationWorkXpEventRecipient")
  gamificationTriggeredWorkXpEvents GamificationWorkXpEvent[]          @relation("GamificationWorkXpEventTrigger")
  gamificationLeaderboardPreference GamificationLeaderboardPreference? @relation("GamificationLeaderboardPreferenceTarget")
  securityStepUpGrants              SecurityStepUpGrant[]              @relation("SecurityStepUpGrantTarget")
  securityOtpChallenges             SecurityOtpChallenge[]              @relation("SecurityOtpChallengeTarget")

  @@unique([userId, workspaceId])
  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, roleId])
  @@index([workspaceId, departmentId])
  @@index([userId])
  @@map("workspace_memberships")
}

model GamificationXpEntry {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String                   @map("workspace_id") @db.Uuid
  membershipId      String                   @map("membership_id") @db.Uuid
  amount            Int
  entryType         GamificationXpEntryType  @map("entry_type")
  sourceType        GamificationXpSourceType @map("source_type")
  sourceEvent       String                   @map("source_event") @db.VarChar(80)
  sourceEntityId    String?                  @map("source_entity_id") @db.Uuid
  idempotencyKey    String?                  @map("idempotency_key") @db.VarChar(160)
  reversalOfEntryId String?                  @map("reversal_of_entry_id") @db.Uuid
  workXpEventId     String?                  @map("work_xp_event_id") @db.Uuid
  actorMembershipId String?                  @map("actor_membership_id") @db.Uuid
  reason            String?                  @db.VarChar(500)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace       Workspace             @relation("GamificationXpEntryWorkspace", fields: [workspaceId], references: [id], onDelete: Restrict)
  membership      WorkspaceMembership   @relation("GamificationXpEntryTarget", fields: [membershipId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  actorMembership WorkspaceMembership?  @relation("GamificationXpEntryActor", fields: [actorMembershipId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  reversalOfEntry GamificationXpEntry?  @relation("GamificationXpEntryReversal", fields: [reversalOfEntryId], references: [id], onDelete: Restrict)
  reversalEntries GamificationXpEntry[] @relation("GamificationXpEntryReversal")
  workXpEvent     GamificationWorkXpEvent? @relation("GamificationXpEntryWorkXpEvent", fields: [workXpEventId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([id, workspaceId])
  @@index([workspaceId, membershipId, createdAt, id])
  @@index([workspaceId, membershipId])
  @@index([workspaceId, sourceType, sourceEvent])
  @@index([workspaceId, workXpEventId])
  @@index([actorMembershipId, workspaceId])
  @@map("gamification_xp_entries")
}

model GamificationWorkXpEvent {
  id                             String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId                    String                         @map("workspace_id") @db.Uuid
  recipientMembershipId          String?                        @map("recipient_membership_id") @db.Uuid
  triggeredByMembershipId        String?                        @map("triggered_by_membership_id") @db.Uuid
