model Asset {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String      @map("workspace_id") @db.Uuid
  projectId        String?     @map("project_id") @db.Uuid
  createdById      String      @map("created_by_id") @db.Uuid
  originalFilename String      @map("original_filename") @db.VarChar(255)
  displayName      String      @map("display_name") @db.VarChar(255)
  storageBucket    String      @map("storage_bucket") @db.VarChar(120)
  storageKey       String      @unique @map("storage_key") @db.VarChar(512)
  mimeType         String      @map("mime_type") @db.VarChar(160)
  extension        String?     @db.VarChar(24)
  sizeBytes        BigInt      @map("size_bytes")
  checksum         String?     @db.VarChar(64)
  status           AssetStatus @default(PENDING)
  metadata         Json?
  uploadExpiresAt  DateTime    @map("upload_expires_at") @db.Timestamptz(6)
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project        Project?        @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  createdBy      User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  attachments    Attachment[]
  processingJobs ProcessingJob[]

  @@unique([id, workspaceId])
  @@unique([id, projectId, workspaceId])
  @@unique([id, projectId, workspaceId, storageKey])
  @@index([workspaceId, projectId])
  @@index([workspaceId, projectId, status])
  @@index([workspaceId, projectId, createdAt])
  @@map("assets")
}

