generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AgencyStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum RoleScope {
  LEGACY_ORGANIZATION
  AGENCY
  WORKSPACE
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AssetStatus {
  PENDING
  UPLOADING
  UPLOADED
  PROCESSING
  READY
  FAILED
  DELETED
}

enum ProcessingJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum StatusEntityType {
  TASK
  PROJECT
  TICKET
}

enum StatusCategory {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskCommentVisibility {
  NORMAL
  INTERNAL
}

enum TaskCommentReactionType {
  LIKE
  LOVE
  CELEBRATE
  EYES
  CHECK
}

model SystemHealth {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  component String   @db.VarChar(120)
  status    String   @db.VarChar(40)
  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)
  metadata  Json?

  @@index([component], map: "idx_system_health_component")
  @@map("system_health")
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String     @unique @db.VarChar(320)
  name         String?    @db.VarChar(160)
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships             Membership[]
  agencyMemberships       AgencyMembership[]
  workspaceMemberships    WorkspaceMembership[]
  refreshTokens           RefreshToken[]
  projects                Project[]             @relation("ProjectCreator")
  tasksCreated            Task[]                @relation("TaskCreator")
  tasksUpdated            Task[]                @relation("TaskUpdater")
  taskDependenciesCreated TaskDependency[]      @relation("TaskDependencyCreator")
  taskRelatedLinksCreated TaskRelatedTask[]     @relation("TaskRelatedTaskCreator")
  taskCommentsAuthored    TaskComment[]         @relation("TaskCommentAuthorUser")
  assets                  Asset[]
  auditLogs               AuditLog[]
  agenciesCreated         Agency[]              @relation("AgencyCreator")
  workspacesCreated       Workspace[]           @relation("WorkspaceCreator")

  @@map("users")
}

model Organization {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String             @db.VarChar(160)
  slug              String             @unique @db.VarChar(120)
  status            OrganizationStatus @default(ACTIVE)
  storageUsedBytes  BigInt             @default(0) @map("storage_used_bytes")
  storageLimitBytes BigInt             @default(1073741824) @map("storage_limit_bytes")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships Membership[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

model Agency {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String       @db.VarChar(160)
  slug        String       @unique @db.VarChar(120)
  status      AgencyStatus @default(ACTIVE)
  createdById String       @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy           User                 @relation("AgencyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  memberships         AgencyMembership[]
  workspaces          Workspace[]
  featureEntitlements FeatureEntitlement[]
  auditLogs           AuditLog[]

  @@index([status])
  @@index([createdById])
  @@map("agencies")
}

model Workspace {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agencyId          String          @map("agency_id") @db.Uuid
  name              String          @db.VarChar(160)
  slug              String          @db.VarChar(120)
  status            WorkspaceStatus @default(ACTIVE)
  storageUsedBytes  BigInt          @default(0) @map("storage_used_bytes")
  storageLimitBytes BigInt          @default(1073741824) @map("storage_limit_bytes")
  createdById       String          @map("created_by_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  agency              Agency                @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  createdBy           User                  @relation("WorkspaceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  memberships         WorkspaceMembership[]
  departments         Department[]
  statusDefinitions   StatusDefinition[]
  projects            Project[]
  tasks               Task[]
  taskAssignees       TaskAssignee[]
  taskFollowers       TaskFollower[]
  taskProjects        TaskProject[]
  taskDependencies    TaskDependency[]
  taskRelatedTasks    TaskRelatedTask[]
  taskComments        TaskComment[]
  taskCommentMentions TaskCommentMention[]
  taskCommentReactions TaskCommentReaction[]
  assets              Asset[]
  processingJobs      ProcessingJob[]
  featureEntitlements FeatureEntitlement[]
  auditLogs           AuditLog[]

  @@unique([agencyId, slug])
  @@unique([id, agencyId])
  @@index([agencyId])
  @@index([agencyId, status])
  @@map("workspaces")
}

model Department {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String           @map("workspace_id") @db.Uuid
  name                String           @db.VarChar(160)
  description         String?          @db.VarChar(500)
  status              DepartmentStatus @default(ACTIVE)
  managerMembershipId String?          @map("manager_membership_id") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  managerMembership WorkspaceMembership?  @relation("DepartmentManager", fields: [managerMembershipId], references: [id], onDelete: SetNull)
  members           WorkspaceMembership[] @relation("DepartmentMembers")
  tasks             Task[]

  @@unique([workspaceId, name])
  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, managerMembershipId])
  @@map("departments")
}

model Membership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  roleId         String           @map("role_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

model AgencyMembership {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  agencyId  String           @map("agency_id") @db.Uuid
  roleId    String           @map("role_id") @db.Uuid
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  agency Agency @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, agencyId])
  @@index([agencyId])
  @@index([userId])
  @@map("agency_memberships")
}

model WorkspaceMembership {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  workspaceId  String           @map("workspace_id") @db.Uuid
  roleId       String           @map("role_id") @db.Uuid
  departmentId String?          @map("department_id") @db.Uuid
  status       MembershipStatus @default(ACTIVE)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user               User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  workspace          Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  role               Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  department         Department?    @relation("DepartmentMembers", fields: [departmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  managedDepartments Department[]   @relation("DepartmentManager")
  assignedTasks      TaskAssignee[]
  followedTasks      TaskFollower[]
  taskComments       TaskComment[]         @relation("TaskCommentAuthor")
  commentMentions    TaskCommentMention[]
  commentReactions   TaskCommentReaction[]

  @@unique([userId, workspaceId])
  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, roleId])
  @@index([workspaceId, departmentId])
  @@index([userId])
  @@map("workspace_memberships")
}

model Role {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key            String    @unique @db.VarChar(120)
  name           String    @db.VarChar(80)
  nameNormalized String?   @map("name_normalized") @db.VarChar(80)
  scope          RoleScope @default(WORKSPACE)
  isSystem       Boolean   @default(true) @map("is_system")
  isActive       Boolean   @default(true) @map("is_active")
  workspaceId    String?   @map("workspace_id") @db.Uuid
  description    String?   @db.VarChar(240)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships          Membership[]
  agencyMemberships    AgencyMembership[]
  workspaceMemberships WorkspaceMembership[]
  rolePermissions      RolePermission[]

  @@unique([workspaceId, nameNormalized])
  @@index([scope])
  @@index([workspaceId])
  @@index([workspaceId, isActive])
  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique @db.VarChar(120)
  description String?  @db.VarChar(240)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model StatusDefinition {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String           @map("workspace_id") @db.Uuid
  entityType     StatusEntityType @map("entity_type")
  name           String           @db.VarChar(80)
  nameNormalized String           @map("name_normalized") @db.VarChar(80)
  description    String?          @db.VarChar(240)
  color          String           @db.VarChar(7)
  position       Int
  category       StatusCategory
  isDefault      Boolean          @default(false) @map("is_default")
  isTerminal     Boolean          @default(false) @map("is_terminal")
  isActive       Boolean          @default(true) @map("is_active")
  isSystem       Boolean          @default(false) @map("is_system")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  projects  Project[]
  tasks     Task[]

  @@unique([workspaceId, entityType, nameNormalized])
  @@unique([id, workspaceId])
  @@index([workspaceId, entityType, isActive, position])
  @@map("status_definitions")
}

model RefreshToken {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash")
  csrfTokenHash String    @map("csrf_token_hash")
  familyId      String    @map("family_id") @db.Uuid
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy    String?   @map("replaced_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Project {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String        @map("workspace_id") @db.Uuid
  name               String        @db.VarChar(160)
  description        String?       @db.VarChar(1000)
  status             ProjectStatus @default(DRAFT)
  statusDefinitionId String?       @map("status_definition_id") @db.Uuid
  createdById        String        @map("created_by_id") @db.Uuid
  archivedAt         DateTime?     @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  statusDefinition StatusDefinition? @relation(fields: [statusDefinitionId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  createdBy        User              @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assets           Asset[]
  processingJobs   ProcessingJob[]
  taskLinks        TaskProject[]

  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, statusDefinitionId])
  @@index([workspaceId, createdAt])
  @@map("projects")
}

model Task {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String       @map("workspace_id") @db.Uuid
  title              String       @db.VarChar(160)
  description        String?      @db.VarChar(4000)
  priority           TaskPriority @default(MEDIUM)
  statusDefinitionId String       @map("status_definition_id") @db.Uuid
  parentTaskId       String?      @map("parent_task_id") @db.Uuid
  departmentId       String?      @map("department_id") @db.Uuid
  dueAt              DateTime?    @map("due_at") @db.Timestamptz(6)
  createdById        String       @map("created_by_id") @db.Uuid
  updatedById        String?      @map("updated_by_id") @db.Uuid
  archivedAt         DateTime?    @map("archived_at") @db.Timestamptz(6)
  deletedAt          DateTime?    @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace             Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  statusDefinition      StatusDefinition  @relation(fields: [statusDefinitionId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  parentTask            Task?             @relation("TaskHierarchy", fields: [parentTaskId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  subtasks              Task[]            @relation("TaskHierarchy")
  department            Department?       @relation(fields: [departmentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  createdBy             User              @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy             User?             @relation("TaskUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  assignees             TaskAssignee[]
  followers             TaskFollower[]
  projects              TaskProject[]
  blockingDependencies  TaskDependency[]  @relation("TaskDependencyBlocker")
  blockedByDependencies TaskDependency[]  @relation("TaskDependencyBlocked")
  relatedTaskALinks     TaskRelatedTask[] @relation("TaskRelatedTaskA")
  relatedTaskBLinks     TaskRelatedTask[] @relation("TaskRelatedTaskB")
  comments              TaskComment[]

  @@unique([id, workspaceId])
  @@index([workspaceId, statusDefinitionId, createdAt])
  @@index([workspaceId, priority, createdAt])
  @@index([workspaceId, dueAt])
  @@index([workspaceId, parentTaskId, createdAt])
  @@index([workspaceId, departmentId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, createdById])
  @@map("tasks")
}

model TaskDependency {
  workspaceId   String   @map("workspace_id") @db.Uuid
  blockerTaskId String   @map("blocker_task_id") @db.Uuid
  blockedTaskId String   @map("blocked_task_id") @db.Uuid
  createdById   String   @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  blockerTask Task      @relation("TaskDependencyBlocker", fields: [blockerTaskId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  blockedTask Task      @relation("TaskDependencyBlocked", fields: [blockedTaskId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  createdBy   User      @relation("TaskDependencyCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@id([blockerTaskId, blockedTaskId])
  @@index([workspaceId, blockerTaskId, createdAt])
  @@index([workspaceId, blockedTaskId, createdAt])
  @@map("task_dependencies")
}

model TaskRelatedTask {
  workspaceId String   @map("workspace_id") @db.Uuid
  taskAId     String   @map("task_a_id") @db.Uuid
  taskBId     String   @map("task_b_id") @db.Uuid
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  taskA     Task      @relation("TaskRelatedTaskA", fields: [taskAId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  taskB     Task      @relation("TaskRelatedTaskB", fields: [taskBId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  createdBy User      @relation("TaskRelatedTaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@id([taskAId, taskBId])
  @@index([workspaceId, taskAId, createdAt])
  @@index([workspaceId, taskBId, createdAt])
  @@map("task_related_tasks")
}

model TaskComment {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String                @map("workspace_id") @db.Uuid
  taskId             String                @map("task_id") @db.Uuid
  authorMembershipId String                @map("author_membership_id") @db.Uuid
  authorUserId       String                @map("author_user_id") @db.Uuid
  parentCommentId    String?               @map("parent_comment_id") @db.Uuid
  body               String                @db.VarChar(4000)
  visibility         TaskCommentVisibility @default(NORMAL)
  editedAt           DateTime?             @map("edited_at") @db.Timestamptz(6)
  deletedAt          DateTime?             @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  task             Task                   @relation(fields: [taskId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  authorMembership WorkspaceMembership    @relation("TaskCommentAuthor", fields: [authorMembershipId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  authorUser       User                   @relation("TaskCommentAuthorUser", fields: [authorUserId], references: [id], onDelete: Restrict)
  parentComment    TaskComment?           @relation("TaskCommentThread", fields: [parentCommentId, workspaceId, taskId], references: [id, workspaceId, taskId], onDelete: Restrict)
  replies          TaskComment[]          @relation("TaskCommentThread")
  mentions         TaskCommentMention[]
  reactions        TaskCommentReaction[]

  @@unique([id, workspaceId])
  @@unique([id, workspaceId, taskId])
  @@index([workspaceId, taskId, parentCommentId, createdAt])
  @@index([workspaceId, taskId, createdAt])
  @@index([workspaceId, authorMembershipId, createdAt])
  @@map("task_comments")
}

model TaskCommentMention {
  workspaceId  String   @map("workspace_id") @db.Uuid
  commentId    String   @map("comment_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  comment    TaskComment         @relation(fields: [commentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  membership WorkspaceMembership @relation(fields: [membershipId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@id([commentId, membershipId])
  @@index([workspaceId, membershipId])
  @@index([workspaceId, commentId])
  @@map("task_comment_mentions")
}

model TaskCommentReaction {
  workspaceId  String                  @map("workspace_id") @db.Uuid
  commentId    String                  @map("comment_id") @db.Uuid
  membershipId String                  @map("membership_id") @db.Uuid
  reactionType TaskCommentReactionType @map("reaction_type")
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  comment    TaskComment         @relation(fields: [commentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  membership WorkspaceMembership @relation(fields: [membershipId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@id([commentId, membershipId, reactionType])
  @@index([workspaceId, commentId, reactionType])
  @@index([workspaceId, membershipId])
  @@map("task_comment_reactions")
}

model TaskAssignee {
  taskId       String   @map("task_id") @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  task       Task                @relation(fields: [taskId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  membership WorkspaceMembership @relation(fields: [membershipId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@id([taskId, membershipId])
  @@index([workspaceId, membershipId])
  @@map("task_assignees")
}

model TaskFollower {
  taskId       String   @map("task_id") @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  task       Task                @relation(fields: [taskId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  membership WorkspaceMembership @relation(fields: [membershipId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@id([taskId, membershipId])
  @@index([workspaceId, membershipId])
  @@map("task_followers")
}

model TaskProject {
  taskId      String   @map("task_id") @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  projectId   String   @map("project_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  task      Task      @relation(fields: [taskId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project   Project   @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@id([taskId, projectId])
  @@index([workspaceId, projectId])
  @@map("task_projects")
}

model Asset {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String      @map("workspace_id") @db.Uuid
  projectId        String      @map("project_id") @db.Uuid
  createdById      String      @map("created_by_id") @db.Uuid
  originalFilename String      @map("original_filename") @db.VarChar(255)
  displayName      String      @map("display_name") @db.VarChar(255)
  storageBucket    String      @map("storage_bucket") @db.VarChar(120)
  storageKey       String      @unique @map("storage_key") @db.VarChar(512)
  mimeType         String      @map("mime_type") @db.VarChar(160)
  extension        String?     @db.VarChar(24)
  sizeBytes        BigInt      @map("size_bytes")
  checksum         String?     @db.VarChar(64)
  status           AssetStatus @default(PENDING)
  metadata         Json?
  uploadExpiresAt  DateTime    @map("upload_expires_at") @db.Timestamptz(6)
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz(6)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project        Project         @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  createdBy      User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  processingJobs ProcessingJob[]

  @@unique([id, workspaceId])
  @@unique([id, projectId, workspaceId])
  @@unique([id, projectId, workspaceId, storageKey])
  @@index([workspaceId, projectId])
  @@index([workspaceId, projectId, status])
  @@index([workspaceId, projectId, createdAt])
  @@map("assets")
}

model ProcessingJob {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String              @map("workspace_id") @db.Uuid
  projectId     String              @map("project_id") @db.Uuid
  assetId       String              @map("asset_id") @db.Uuid
  type          String              @db.VarChar(80)
  status        ProcessingJobStatus @default(QUEUED)
  attempts      Int                 @default(0)
  progress      Int                 @default(0)
  errorCode     String?             @map("error_code") @db.VarChar(80)
  errorMessage  String?             @map("error_message") @db.VarChar(512)
  correlationId String              @map("correlation_id") @db.VarChar(120)
  startedAt     DateTime?           @map("started_at") @db.Timestamptz(6)
  completedAt   DateTime?           @map("completed_at") @db.Timestamptz(6)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project   Project   @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  asset     Asset     @relation(fields: [assetId, projectId, workspaceId], references: [id, projectId, workspaceId], onDelete: Restrict)

  @@unique([assetId, type])
  @@index([workspaceId, projectId])
  @@index([assetId, status])
  @@index([status, createdAt])
  @@map("processing_jobs")
}

model FeatureDefinition {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key              String   @unique @db.VarChar(120)
  name             String   @db.VarChar(160)
  description      String?  @db.VarChar(240)
  enabledByDefault Boolean  @default(false) @map("enabled_by_default")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  entitlements FeatureEntitlement[]

  @@map("feature_definitions")
}

model FeatureEntitlement {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  featureId   String   @map("feature_id") @db.Uuid
  agencyId    String?  @map("agency_id") @db.Uuid
  workspaceId String?  @map("workspace_id") @db.Uuid
  enabled     Boolean
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  feature   FeatureDefinition @relation(fields: [featureId], references: [id], onDelete: Cascade)
  agency    Agency?           @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  workspace Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@index([workspaceId])
  @@map("feature_entitlements")
}

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  agencyId       String?  @map("agency_id") @db.Uuid
  workspaceId    String?  @map("workspace_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String   @db.VarChar(120)
  entityType     String   @map("entity_type") @db.VarChar(80)
  entityId       String?  @map("entity_id") @db.Uuid
  metadata       Json?
  ipAddress      String?  @map("ip_address") @db.VarChar(80)
  userAgent      String?  @map("user_agent") @db.VarChar(512)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  agency       Agency?       @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  workspace    Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([agencyId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
